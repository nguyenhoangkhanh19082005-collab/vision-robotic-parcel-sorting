<launch>

<rosparam file="$(find ROBOTARM2_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="ROBOTARM2" args="Revolute 8_position_controller Revolute 9_position_controller Revolute 10_position_controller Revolute 11_position_controller Revolute 12_position_controller Revolute 13_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/ROBOTARM2/joint_states"/>
</node>

</launch>